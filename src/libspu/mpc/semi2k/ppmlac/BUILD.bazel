load("//bazel:spu.bzl", "spu_cc_library")

package(default_visibility = ["//visibility:public"])

spu_cc_library(
    name = "ppmlac",
    hdrs = ["ppmlac.h"],
    deps = [
        "//libspu/core:context",
        "//libspu/core:ndarray_ref",
        "@yacl//yacl/link",
    ],
)

spu_cc_library(
    name = "ppmlac_receiver",
    srcs = ["ppmlac_receiver.cc"],
    hdrs = ["ppmlac_receiver.h"],
    deps = [
        ":bit_set",
        ":ppmlac",
        "//libspu/mpc/common:communicator",
        "//libspu/mpc/semi2k:type",
        "//libspu/mpc/semi2k/ppmlac/trusted_chip:stream_reader",
        "//libspu/mpc/semi2k/ppmlac/trusted_chip:trusted_service_cc_proto",
    ],
)

spu_cc_library(
    name = "ppmlac_sender",
    srcs = ["ppmlac_sender.cc"],
    hdrs = ["ppmlac_sender.h"],
    deps = [
        ":bit_set",
        ":ppmlac",
        "//libspu/mpc/common:communicator",
        "//libspu/mpc/semi2k:type",
        "//libspu/mpc/semi2k/ppmlac/trusted_chip",
    ],
)

spu_cc_library(
    name = "bit_set",
    hdrs = ["bit_set.h"],
    deps = [
        ":utils",
    ],
)

spu_cc_library(
    name = "utils",
    srcs = ["utils.cc"],
    hdrs = ["utils.h"],
    deps = [
        ":stream_meta",
        "//libspu/core:prelude",
        "@brpc",
        "@yacl//yacl/base:buffer",
    ],
)

# TODO: delete me
spu_cc_library(
    name = "stream_meta",
    hdrs = ["stream_meta.h"],
)
